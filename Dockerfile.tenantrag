FROM python:3.12-slim
WORKDIR /srv
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
COPY requirements-tenantrag.txt .
RUN pip install --no-cache-dir -r requirements-tenantrag.txt
COPY app ./app
COPY tenantrag ./tenantrag
COPY alembic_postgres ./alembic_postgres
COPY alembic-postgres.ini .
EXPOSE 8100
CMD ["uvicorn", "tenantrag.api.demo:app", "--host", "0.0.0.0", "--port", "8100"]
