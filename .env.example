# =============================================================================
# .env.example
# Copy this to .env and fill in real values. Never commit the actual .env file.
# =============================================================================

# --- MySQL (read by main.py, ai_assistant.py, and scanning.py independently) ---
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=your_mysql_user
MYSQL_PASSWORD=your_mysql_password
MYSQL_DB=rag_chatbot

# --- Vector store ---
CHROMA_DB_BASE_DIR=./chroma_db_base

# --- Embeddings ---
# NOTE: scanning.py reads this from env, but ai_assistant.py currently
# hardcodes "nomic-embed-text" instead of reading this variable. That's a
# real inconsistency found during the Phase 1 audit — fixed once
# ai_assistant.py is migrated into app/infrastructure/llm.
EMBEDDING_MODEL=nomic-embed-text

# --- App / concurrency ---
MAX_WORKERS=10

# --- Document scanning / translation service (scanning.py) ---
# NOTE: SCANNER_TENANT_ID being a single global env var conflicts with the
# app's otherwise multi-tenant design (tenant_id is normally passed per
# request). Flagged for the architecture phase, not fixed here.
API_URL=https://your-omni-api-host/endpoint
AUTH_URL=https://your-omni-api-host/auth
TENANT_ID=your_default_tenant_id
FONT_PATH=NotoSans-Regular.ttf
OUTPUT_DIR=./reports

# =============================================================================
# The variables below are NOT read by the original code yet — they're used by
# the new app/core/config.py Settings introduced in the Phase 1 refactor.
# Once main.py/ai_assistant.py/scanning.py are migrated to use Settings,
# everything above and below merges into one consistent list.
# =============================================================================

# --- App metadata ---
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- CORS ---
# Comma-separated list; the original code had this hardcoded to "*" which
# is a real vulnerability when combined with allow_credentials=True.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- MySQL pool sizing ---
MYSQL_POOL_SIZE=10

# --- LLM ---
LLM_MODEL_NAME=meta-llama/Llama-3.2-3B-Instruct
LLM_MAX_NEW_TOKENS=512
LLM_TEMPERATURE=0.3

# --- Token lifetimes ---
SESSION_TOKEN_TTL_HOURS=24
CUSTOMER_TOKEN_TTL_DAYS=30