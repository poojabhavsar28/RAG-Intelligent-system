# Copy to .env and replace every placeholder. Never commit .env.

# PostgreSQL/pgvector
POSTGRES_DB=tenantrag
POSTGRES_USER=tenantrag_app
POSTGRES_PASSWORD=replace-with-a-strong-local-secret
POSTGRES_PORT=5432
DATABASE_BACKEND=postgres
POSTGRES_ADMIN_DATABASE_URL=postgresql://tenantrag_app:replace-with-a-strong-local-secret@localhost:5432/tenantrag
POSTGRES_DATABASE_URL=postgresql://tenantrag_runtime:replace-with-runtime-secret@localhost:5432/tenantrag
POSTGRES_POOL_SIZE=10
POSTGRES_MAX_OVERFLOW=10
POSTGRES_POOL_TIMEOUT=30

# Ollama (docker-compose.postgres.yml exposes Ollama on localhost)
OLLAMA_PORT=11434
OLLAMA_BASE_URL=http://localhost:11434
EMBEDDING_MODEL=nomic-embed-text
OLLAMA_LLM_MODEL=qwen2.5:3b
LLM_MAX_NEW_TOKENS=512
LLM_TEMPERATURE=0.3

# Application
ENVIRONMENT=development
LOG_LEVEL=INFO
MAX_WORKERS=10
CORS_ALLOWED_ORIGINS=http://localhost:3000
CHROMA_DB_BASE_DIR=./chroma_db_base
SESSION_TOKEN_TTL_HOURS=24
CUSTOMER_TOKEN_TTL_DAYS=30

# Legacy MySQL backend (only used when DATABASE_BACKEND=mysql)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=your_mysql_user
MYSQL_PASSWORD=your_mysql_password
MYSQL_DB=rag_chatbot
MYSQL_POOL_SIZE=10

# Document scanning / translation service
API_URL=https://your-omni-api-host/endpoint
AUTH_URL=https://your-omni-api-host/auth
TENANT_ID=your_default_tenant_id
FONT_PATH=NotoSans-Regular.ttf
OUTPUT_DIR=./reports
